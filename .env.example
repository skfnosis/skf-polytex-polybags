VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Optional: Cloudflare Turnstile site key for the login screen's bot check.
# Leave blank and login works exactly as before. To turn it on:
#   1. Create a Turnstile widget at https://dash.cloudflare.com/?to=/:account/turnstile
#      (any domain works, including localhost) and copy its Site Key + Secret Key.
#   2. In the Supabase Dashboard: Authentication -> Attack Protection -> enable
#      CAPTCHA protection, choose Turnstile, paste the Secret Key.
#   3. Set VITE_TURNSTILE_SITE_KEY below (and in Vercel's project env vars) to
#      the Site Key from step 1, then redeploy.
VITE_TURNSTILE_SITE_KEY=
